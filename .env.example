# Database (MongoDB Atlas connection string)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/bit_fleet?retryWrites=true&w=majority"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL="http://localhost:5173"

# Email SMTP (Gmail or Brevo)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="your-email@gmail.com"
SMTP_FROM_NAME="BIT Centralized Vehicle Fleet Booking Portal"
