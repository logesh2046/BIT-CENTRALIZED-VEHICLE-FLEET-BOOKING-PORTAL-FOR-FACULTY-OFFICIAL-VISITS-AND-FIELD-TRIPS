generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  name         String
  phone        String?
  role         String   @default("FACULTY")
  departmentId Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department    Department?    @relation(fields: [departmentId], references: [id])
  bookings      Booking[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([role])
  @@index([departmentId])
}

model Vehicle {
  id                 Int      @id @default(autoincrement())
  registrationNumber String   @unique
  vehicleType        String
  model              String
  seatingCapacity    Int
  status             String   @default("AVAILABLE")
  insuranceExpiry    DateTime?
  fitnessExpiry      DateTime?
  maintenanceInfo    String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  allocations VehicleAllocation[]

  @@index([status])
}

model Driver {
  id                Int      @id @default(autoincrement())
  name              String
  phone             String
  licenseNumber     String   @unique
  licenseExpiry     DateTime
  status            String   @default("AVAILABLE")
  assignedVehicleId Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  userId            Int?     @unique

  allocations VehicleAllocation[]

  @@index([status])
}

model Booking {
  id                  Int      @id @default(autoincrement())
  userId              Int
  facultyName         String
  department          String
  contactNumber       String
  purpose             String
  destination         String
  startingLocation    String
  travelDate          DateTime
  departureTime       String
  returnDate          DateTime
  returnTime          String
  numberOfPassengers  Int
  vehicleType         String
  specialRequirements String?
  remarks             String?
  status              String   @default("PENDING")
  rejectionRemarks    String?
  approvedBy          Int?
  approvedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user       User               @relation(fields: [userId], references: [id])
  allocation VehicleAllocation?
  tripStatus TripStatus[]

  @@index([status])
  @@index([userId])
  @@index([travelDate])
}

model VehicleAllocation {
  id          Int      @id @default(autoincrement())
  bookingId   Int      @unique
  vehicleId   Int
  driverId    Int
  allocatedBy Int
  allocatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  driver  Driver  @relation(fields: [driverId], references: [id])

  @@index([vehicleId])
  @@index([driverId])
}

model TripStatus {
  id        Int      @id @default(autoincrement())
  bookingId Int
  status    String   @default("ASSIGNED")
  remarks   String?
  updatedBy Int
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  relatedId Int?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  action      String
  entity      String
  entityId    Int?
  description String
  metadata    String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model EmailLog {
  id            Int      @id @default(autoincrement())
  recipient     String
  recipientRole String?
  subject       String
  bookingId     Int?
  status        String   // "SENT", "FAILED", "PENDING"
  error         String?
  sentAt        DateTime?
  createdAt     DateTime @default(now())

  @@index([bookingId])
  @@index([status])
}

