{
  "name": "server",
  "version": "1.0.0",
  "description": "BIT Vehicle Fleet Management Backend Server",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "prisma:generate": "npx prisma generate --schema=../prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate dev --schema=../prisma/schema.prisma",
    "prisma:push": "npx prisma db push --schema=../prisma/schema.prisma",
    "seed": "node ../prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.7.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0"
  }
}
